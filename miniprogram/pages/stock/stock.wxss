.mb-10 {
  margin-bottom: 10px !important;
}

.header-action-wrap {
  display: flex;
  align-items: center;
}

/* 租户协同池提示条 */
.stock-tenant-notice {
  margin: 0 16px;
  padding: 10px 14px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.factory-notice {
  background-color: #EBF5ED;
  border: 1px solid #C8DEC9;
}

.personal-notice {
  background-color: #F3F3F3;
  border: 1px solid #E2E2E2;
}

.notice-content {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
}

.notice-text {
  font-size: 12px;
  line-height: 1.4;
  color: #333333;
}

.notice-btn {
  display: flex;
  align-items: center;
  gap: 2px;
  flex-shrink: 0;
}

.go-saas-text {
  font-size: 12px;
  color: #1A4D2E;
  font-weight: 600;
}

.stock-tags-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.list {
  padding-bottom: 40px;
}
.stock-swipe {
  margin-top: 1px;
}
.swipe-right-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 100%;
  background-color: var(--td-error-color);
  color: white;
}
.empty-state {
  text-align: center;
  padding: 40px 0;
  color: #999;
}

