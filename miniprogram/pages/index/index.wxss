.home { padding: 0 28rpx 48rpx; color: #18231c; }
.home-hero { padding: 56rpx 12rpx 34rpx; text-align: left; }
.eyebrow { margin-bottom: 10rpx; color: #607467; font-size: 24rpx; font-weight: 600; letter-spacing: 4rpx; }
.home-hero .title { margin-bottom: 12rpx; font-size: 52rpx; line-height: 1.15; }
.home-hero .subtitle { max-width: 620rpx; color: #526158; font-size: 28rpx; line-height: 1.7; }
.demo-card { padding: 32rpx; border-radius: 28rpx; background: linear-gradient(145deg, #e5f2e8 0%, #f3ead7 100%); box-shadow: 0 14rpx 36rpx rgba(26, 77, 46, 0.10); }
.demo-copy { margin-bottom: 26rpx; }
.demo-kicker { color: #6f795d; font-size: 24rpx; font-weight: 600; }
.demo-title { margin: 8rpx 0; color: #173d26; font-size: 38rpx; font-weight: 700; }
.demo-desc { color: #536158; font-size: 26rpx; line-height: 1.6; }
.section-title { margin: 42rpx 8rpx 20rpx; color: #24372b; font-size: 30rpx; font-weight: 700; }
.workflow-card, .inventory-card, .secondary-actions { overflow: hidden; border: 1rpx solid #e3e8e3; border-radius: 24rpx; background: #ffffff; }
.workflow-step { display: flex; align-items: center; min-height: 116rpx; padding: 20rpx 24rpx; }
.step-number { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; margin-right: 22rpx; border-radius: 50%; background: #1a4d2e; color: #ffffff; font-size: 26rpx; font-weight: 700; }
.final-step .step-number { background: #dfece2; color: #1a4d2e; }
.step-copy, .inventory-copy { flex: 1; min-width: 0; }
.step-title, .inventory-title { color: #203127; font-size: 29rpx; font-weight: 650; }
.step-desc, .inventory-desc { margin-top: 7rpx; color: #718077; font-size: 24rpx; line-height: 1.5; }
.step-line { height: 1rpx; margin-left: 100rpx; background: #edf0ed; }
.inventory-card { display: flex; align-items: center; margin-top: 24rpx; padding: 26rpx 24rpx; }
.inventory-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 20rpx; border-radius: 20rpx; background: #edf5ef; }
.empty .inventory-copy { margin-right: 18rpx; }
.primary-actions { margin-top: 28rpx; }
.secondary-actions { display: flex; align-items: center; margin-top: 24rpx; padding: 22rpx 0; }
.secondary-item { display: flex; flex: 1; align-items: center; justify-content: center; gap: 12rpx; color: #385043; font-size: 27rpx; }
.secondary-divider { width: 1rpx; height: 40rpx; background: #e6ebe7; }
.home-footer { padding: 38rpx 0 10rpx; color: #8a958e; font-size: 22rpx; text-align: center; }


.shape-mode-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.shape-mode-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #DDE5DF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(24, 92, 55, 0.06);
}
.shape-mode-card.recommended { border-color: #185C37; background: #F1F8F3; }
.shape-mode-code {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 18rpx;
  color: #FFFFFF;
  background: #185C37;
  font-size: 30rpx;
  font-weight: 700;
}
.shape-mode-copy { flex: 1; min-width: 0; }
.shape-mode-title { color: #183D29; font-size: 29rpx; font-weight: 650; }
.shape-mode-desc { margin-top: 6rpx; color: #66756B; font-size: 23rpx; line-height: 1.45; }
.shape-mode-badge {
  position: absolute;
  top: -12rpx;
  right: 20rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #F06A2A;
  font-size: 20rpx;
  font-weight: 600;
}

.agent-entry { margin-bottom: 24rpx; padding: 32rpx; border-radius: 28rpx; background: #173d26; box-shadow: 0 16rpx 38rpx rgba(21, 61, 37, .18); color: #fff; }
.agent-entry-tag { color: #f5b488; font-size: 21rpx; font-weight: 700; letter-spacing: 1rpx; }
.agent-entry-title { margin: 10rpx 0 8rpx; font-size: 38rpx; font-weight: 750; }
.agent-entry-desc { margin-bottom: 20rpx; color: #d8e6dc; font-size: 24rpx; line-height: 1.55; }
.agent-entry t-button { margin-top: 18rpx; }
.agent-demo-row { display: flex; justify-content: space-around; margin-top: 20rpx; color: #d5eada; font-size: 22rpx; }
