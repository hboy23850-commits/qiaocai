.agent-page { min-height: 100vh; padding: 32rpx 28rpx 64rpx; background: #f5f7f4; color: #1c2b21; }
.agent-hero { padding: 24rpx 8rpx 30rpx; }.agent-kicker { color: #c55a24; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }.agent-title { margin-top: 10rpx; font-size: 46rpx; font-weight: 750; }.agent-subtitle { margin-top: 12rpx; color: #617067; font-size: 25rpx; line-height: 1.65; }
.stage-card,.chat-card,.draft-card,.evidence-card,.candidate-card,.composer { margin-bottom: 22rpx; padding: 26rpx; border: 1rpx solid #e0e6e1; border-radius: 24rpx; background: #fff; }.stage-card { display: flex; justify-content: space-between; padding: 22rpx 12rpx; overflow: hidden; }.stage { display:flex;flex:1;flex-direction:column;align-items:center;gap:8rpx;color:#9aa49d;font-size:18rpx;text-align:center; }.stage-dot{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;border-radius:50%;background:#e8ece9;font-size:20rpx}.stage-dot.active{background:#185c37;color:#fff}.active-text{color:#185c37;font-weight:650}
.notice{margin-bottom:20rpx;padding:18rpx 22rpx;border-radius:16rpx;font-size:23rpx;line-height:1.5}.notice.simulated{background:#fff4d7;color:#785a08}.notice.degraded{background:#fff0eb;color:#9a3f1e}
.message{max-width:88%;margin-bottom:16rpx;padding:18rpx 22rpx;border-radius:18rpx;font-size:25rpx;line-height:1.55}.message.assistant{background:#eaf3ec;color:#21462e}.message.user{margin-left:auto;background:#185c37;color:#fff}
.card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}.card-label{color:#78847c;font-size:21rpx}.card-title{color:#183d29;font-size:29rpx;font-weight:700}.lock-badge{padding:7rpx 13rpx;border-radius:999rpx;background:#eef3ef;color:#456052;font-size:20rpx}.detail-row{display:flex;justify-content:space-between;padding:14rpx 0;border-bottom:1rpx solid #edf0ed;color:#5e6e64;font-size:24rpx}.part{margin-top:16rpx;padding:18rpx;border-radius:16rpx;background:#f7f9f7}.part-title{font-size:27rpx;font-weight:650}.part-meta{margin-top:7rpx;color:#6d7a72;font-size:23rpx}
.tool-run{display:flex;gap:16rpx;padding:18rpx 0;border-bottom:1rpx solid #edf0ed}.tool-status{flex:0 0 auto;height:36rpx;padding:0 12rpx;border-radius:999rpx;font-size:19rpx;line-height:36rpx}.tool-status.ok{background:#e4f3e8;color:#23633a}.tool-status.bad{background:#fae8e3;color:#a24425}.tool-copy{font-size:24rpx}.tool-copy text{display:block;margin-top:4rpx;color:#728078;font-size:22rpx}.model-row{margin-top:18rpx;color:#53645a;font-size:22rpx}
.candidate{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:18rpx;padding:18rpx;border-radius:16rpx;background:#f0f6f1;color:#415349;font-size:23rpx}.composer t-button{margin-top:18rpx}.demo-links{display:flex;justify-content:space-between;margin-top:20rpx;color:#185c37;font-size:22rpx}.actions{margin:26rpx 0}.boundary{padding:0 18rpx;color:#89948d;font-size:21rpx;line-height:1.6;text-align:center}
